# jevi-ops web — Next.js 15 standalone build. No secrets are baked in:
# every config value (API_URL, AUTH_SECRET, …) is runtime env, so one image
# serves any deployment.
#
# Build from the REPO ROOT:
#   docker build -f infrastructure/docker/Dockerfile.web -t jevi-ops-web .

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @jevi-ops/web...
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
WORKDIR /repo/apps/web
RUN ./node_modules/.bin/next build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache curl

# Standalone output contains a pruned node_modules + server.js keyed to the
# monorepo layout (outputFileTracingRoot = repo root).
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public

ENV HOSTNAME=0.0.0.0
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3000/sign-in > /dev/null || exit 1

CMD ["node", "apps/web/server.js"]
