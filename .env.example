# Copy to .env and fill in. Never commit the populated .env.
#
# Two tiers of configuration:
#   * This file (env)     — secrets + bootstrap values, read at process start.
#   * Settings dashboard  — LLM / STT / Immich endpoints, editable at runtime
#                           (stored in app_settings; env values below act as
#                           the fallback when a dashboard field is blank).

# ─── Database ──────────────────────────────────────────────────────────────
# Plain PostgreSQL. Dev compose (infrastructure/docker/compose.dev.yml)
# listens on 54329; prod compose wires the internal postgres service.
DATABASE_URL=postgresql://jevi:jevi@localhost:54329/jeviops

# ─── Auth ──────────────────────────────────────────────────────────────────
# Signs session JWTs (API) and verifies them (web middleware) — one secret,
# both apps. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
# 127.0.0.1 for bare-metal dev; the prod container sets 0.0.0.0.
API_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug

# Public origin of the API (the ts.net URL in prod). Used for stored
# attachment URLs served at /uploads/*.
API_PUBLIC_URL=http://localhost:3001

# CORS — comma-separated. In dev, allow the web app.
CORS_ORIGINS=http://localhost:3000

# ─── Web app ───────────────────────────────────────────────────────────────
# Server-side fetches from web → API. In compose this is the internal
# address (http://api:3001).
API_URL=http://localhost:3001
# Public origin of the web app (deep links in notifications + widget).
WEB_APP_URL=http://localhost:3000

# ─── LLM (voice parser + chat) ─────────────────────────────────────────────
# Primary: any OpenAI-compatible server — llama.cpp (`llama-server --jinja`),
# MLX, Ollama, vLLM, LM Studio. Dashboard Settings → AI overrides these.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Cloud fallback (LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-4-8.
ANTHROPIC_MODEL=

# ─── STT (voice memo transcription) ────────────────────────────────────────
# Any OpenAI-compatible /v1/audio/transcriptions server (speaches,
# faster-whisper-server, whisper.cpp server). Defaults to OpenAI cloud,
# which then requires STT_API_KEY.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ─── Image storage ─────────────────────────────────────────────────────────
# Directory for note/journal image attachments (a mounted NAS volume in
# prod). Unset → uploads disabled.
UPLOADS_DIR=

# ─── In-process cron ───────────────────────────────────────────────────────
# true on the single prod api container; leave false in dev (tsx watch
# restarts would double-fire). /api/cron/* endpoints work either way.
CRON_ENABLED=false

# ─── Secrets for external surfaces ─────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Ingest webhook (watch/shortcut/agent capture posts X-Ingest-Secret).
INGEST_WEBHOOK_SECRET=
# Manual/cron HTTP triggering of /api/cron/* (X-Cron-Secret or ?secret=).
CRON_SECRET=
# iOS Scriptable / Android widget quote endpoint (?secret=).
WIDGET_SECRET=
# HMAC for the web→API Google OAuth begin handshake.
OAUTH_BRIDGE_SECRET=

# ─── Google (Calendar sync) ────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI
# (in prod: https://<nas>.<tailnet>.ts.net:8443/api/auth/google/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ─── Pushover (notifications) ──────────────────────────────────────────────
# Task reminders, overdue alerts, daily summary, routine pings.
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
