# Absolute installation directory generated by bootstrap; replace this value.
installation = "/absolute/path/to/jevi-hermes"
api_url = "https://your-jevi-api.example"
# OpenAI-compatible endpoint with tool calling. Explicit URL prevents key fallback.
model_base_url = "https://openrouter.ai/api/v1"
model = "choose-your-provider/model"
poll_seconds = 10
max_model_turns = 20
max_output_tokens = 6000
# Context paging has its own bound; max_requests in each job bounds public fetches.
max_context_pages = 3
